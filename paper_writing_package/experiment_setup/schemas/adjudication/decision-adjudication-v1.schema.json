{
  "$defs": {
    "AdjudicationStatus": {
      "enum": [
        "resolved",
        "unresolved"
      ],
      "title": "AdjudicationStatus",
      "type": "string"
    },
    "CandidateRef": {
      "additionalProperties": false,
      "properties": {
        "candidate_record_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
          "title": "Candidate Record Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "candidate_record_id",
        "source_sha256"
      ],
      "title": "CandidateRef",
      "type": "object"
    },
    "DecisionValue": {
      "enum": [
        "preserve",
        "refine"
      ],
      "title": "DecisionValue",
      "type": "string"
    },
    "InferenceFinishReason": {
      "enum": [
        "stop",
        "length"
      ],
      "title": "InferenceFinishReason",
      "type": "string"
    },
    "ReviewTiming": {
      "enum": [
        "pre_evaluation",
        "evaluation_existed_not_consulted"
      ],
      "title": "ReviewTiming",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One immutable semantic code linked to an unchanged invalid model call.",
  "properties": {
    "adjudication_id": {
      "minLength": 1,
      "title": "Adjudication Id",
      "type": "string"
    },
    "adjudication_record_id": {
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Adjudication Record Id",
      "type": "string"
    },
    "adjudication_run_id": {
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Adjudication Run Id",
      "type": "string"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evaluation_feedback_used": {
      "const": false,
      "default": false,
      "title": "Evaluation Feedback Used",
      "type": "boolean"
    },
    "initial_candidate": {
      "$ref": "#/$defs/CandidateRef"
    },
    "invalid_model_call_record_id": {
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Invalid Model Call Record Id",
      "type": "string"
    },
    "model_configuration_record_id": {
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Model Configuration Record Id",
      "type": "string"
    },
    "original_error_type": {
      "minLength": 1,
      "title": "Original Error Type",
      "type": "string"
    },
    "original_finish_reason": {
      "$ref": "#/$defs/InferenceFinishReason"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "raw_response_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Response Sha256",
      "type": "string"
    },
    "review_timing": {
      "$ref": "#/$defs/ReviewTiming"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "rubric_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rubric Sha256",
      "type": "string"
    },
    "rubric_version": {
      "minLength": 1,
      "title": "Rubric Version",
      "type": "string"
    },
    "schema_version": {
      "const": "decision-adjudication-v1",
      "default": "decision-adjudication-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_inference_run_id": {
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Source Inference Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AdjudicationStatus"
    },
    "study_version": {
      "minLength": 1,
      "title": "Study Version",
      "type": "string"
    },
    "task_record_id": {
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Task Record Id",
      "type": "string"
    }
  },
  "required": [
    "adjudication_record_id",
    "adjudication_id",
    "adjudication_run_id",
    "source_inference_run_id",
    "study_version",
    "invalid_model_call_record_id",
    "task_record_id",
    "model_configuration_record_id",
    "initial_candidate",
    "raw_response_sha256",
    "original_error_type",
    "original_finish_reason",
    "rubric_version",
    "rubric_sha256",
    "reviewer_id",
    "reviewed_at",
    "review_timing",
    "status",
    "rationale"
  ],
  "title": "DecisionAdjudicationRecord",
  "type": "object"
}

{
  "$defs": {
    "CandidateRef": {
      "additionalProperties": false,
      "properties": {
        "candidate_record_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
          "title": "Candidate Record Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "candidate_record_id",
        "source_sha256"
      ],
      "title": "CandidateRef",
      "type": "object"
    },
    "EvaluationAttemptStage": {
      "enum": [
        "primary",
        "confirmation"
      ],
      "title": "EvaluationAttemptStage",
      "type": "string"
    },
    "EvaluationStatus": {
      "enum": [
        "completed",
        "evaluation_failure",
        "timeout",
        "excluded_task"
      ],
      "title": "EvaluationStatus",
      "type": "string"
    },
    "FunctionalOutcome": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "FunctionalOutcome",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "source_record_ids": {
          "default": [],
          "items": {
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
            "type": "string"
          },
          "title": "Source Record Ids",
          "type": "array"
        },
        "study_version": {
          "minLength": 1,
          "title": "Study Version",
          "type": "string"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Record Id"
        }
      },
      "required": [
        "study_version",
        "created_at",
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "minLength": 1,
      "title": "Benchmark Id",
      "type": "string"
    },
    "candidate": {
      "$ref": "#/$defs/CandidateRef"
    },
    "confirmation_evaluation_record_id": {
      "anyOf": [
        {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmation Evaluation Record Id"
    },
    "failure_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Message"
    },
    "failure_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Type"
    },
    "functional_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/FunctionalOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "primary_evaluation_record_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Primary Evaluation Record Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "record_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_type": {
      "const": "evaluation_resolution",
      "default": "evaluation_resolution",
      "title": "Record Type",
      "type": "string"
    },
    "schema_version": {
      "const": "3.0.0",
      "default": "3.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_attempt": {
      "$ref": "#/$defs/EvaluationAttemptStage"
    },
    "status": {
      "$ref": "#/$defs/EvaluationStatus"
    },
    "task_record_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Task Record Id",
      "type": "string"
    },
    "timeout_policy_version": {
      "minLength": 1,
      "title": "Timeout Policy Version",
      "type": "string"
    },
    "total_elapsed_seconds": {
      "minimum": 0,
      "title": "Total Elapsed Seconds",
      "type": "number"
    },
    "upstream_task_id": {
      "minLength": 1,
      "title": "Upstream Task Id",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "provenance",
    "candidate",
    "task_record_id",
    "upstream_task_id",
    "benchmark_id",
    "timeout_policy_version",
    "primary_evaluation_record_id",
    "source_attempt",
    "status",
    "total_elapsed_seconds"
  ],
  "title": "EvaluationResolutionRecord",
  "type": "object"
}

{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "source_record_ids": {
          "default": [],
          "items": {
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
            "type": "string"
          },
          "title": "Source Record Ids",
          "type": "array"
        },
        "study_version": {
          "minLength": 1,
          "title": "Study Version",
          "type": "string"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Record Id"
        }
      },
      "required": [
        "study_version",
        "created_at",
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checkpoint": {
      "minLength": 1,
      "title": "Checkpoint",
      "type": "string"
    },
    "checkpoint_revision": {
      "minLength": 1,
      "title": "Checkpoint Revision",
      "type": "string"
    },
    "configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "decoding_parameters": {
      "additionalProperties": true,
      "title": "Decoding Parameters",
      "type": "object"
    },
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "inference_engine": {
      "minLength": 1,
      "title": "Inference Engine",
      "type": "string"
    },
    "inference_engine_version": {
      "minLength": 1,
      "title": "Inference Engine Version",
      "type": "string"
    },
    "precision": {
      "minLength": 1,
      "title": "Precision",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "record_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_type": {
      "const": "model_configuration",
      "default": "model_configuration",
      "title": "Record Type",
      "type": "string"
    },
    "schema_version": {
      "const": "3.0.0",
      "default": "3.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "serving_parameters": {
      "additionalProperties": true,
      "title": "Serving Parameters",
      "type": "object"
    },
    "tokenizer": {
      "minLength": 1,
      "title": "Tokenizer",
      "type": "string"
    },
    "tokenizer_revision": {
      "minLength": 1,
      "title": "Tokenizer Revision",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "provenance",
    "display_name",
    "checkpoint",
    "checkpoint_revision",
    "inference_engine",
    "inference_engine_version",
    "precision",
    "tokenizer",
    "tokenizer_revision",
    "decoding_parameters",
    "serving_parameters",
    "configuration_sha256"
  ],
  "title": "ModelConfiguration",
  "type": "object"
}

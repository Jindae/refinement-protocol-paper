{
  "$defs": {
    "CandidateRef": {
      "additionalProperties": false,
      "properties": {
        "candidate_record_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
          "title": "Candidate Record Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "candidate_record_id",
        "source_sha256"
      ],
      "title": "CandidateRef",
      "type": "object"
    },
    "InferenceFinishReason": {
      "enum": [
        "stop",
        "length"
      ],
      "title": "InferenceFinishReason",
      "type": "string"
    },
    "ModelCallStatus": {
      "enum": [
        "completed",
        "invalid_response",
        "extraction_failure",
        "inference_failure",
        "timeout"
      ],
      "title": "ModelCallStatus",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "source_record_ids": {
          "default": [],
          "items": {
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
            "type": "string"
          },
          "title": "Source Record Ids",
          "type": "array"
        },
        "study_version": {
          "minLength": 1,
          "title": "Study Version",
          "type": "string"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Record Id"
        }
      },
      "required": [
        "study_version",
        "created_at",
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RawArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "size_bytes"
      ],
      "title": "RawArtifactRef",
      "type": "object"
    },
    "Stage": {
      "enum": [
        "direct_generation",
        "refinement_need_decision",
        "direct_revision",
        "critique_generation",
        "critique_conditioned_revision",
        "revision_planning",
        "plan_conditioned_revision"
      ],
      "title": "Stage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_number": {
      "exclusiveMinimum": 0,
      "title": "Attempt Number",
      "type": "integer"
    },
    "elapsed_seconds": {
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "error_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    },
    "finish_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/InferenceFinishReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "initial_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "logical_call_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Logical Call Id",
      "type": "string"
    },
    "model_configuration_record_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Model Configuration Record Id",
      "type": "string"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "prompt_record_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Prompt Record Id",
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "raw_response": {
      "anyOf": [
        {
          "$ref": "#/$defs/RawArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "record_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_type": {
      "const": "model_call",
      "default": "model_call",
      "title": "Record Type",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "3.0.0",
      "default": "3.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "status": {
      "$ref": "#/$defs/ModelCallStatus"
    },
    "supersedes_call_record_id": {
      "anyOf": [
        {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Call Record Id"
    },
    "task_record_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Task Record Id",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "provenance",
    "logical_call_id",
    "attempt_number",
    "stage",
    "status",
    "task_record_id",
    "model_configuration_record_id",
    "prompt_record_id",
    "prompt_sha256",
    "request_sha256",
    "elapsed_seconds"
  ],
  "title": "ModelCallRecord",
  "type": "object"
}

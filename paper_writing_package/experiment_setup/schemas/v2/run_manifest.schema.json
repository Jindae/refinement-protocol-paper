{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "source_record_ids": {
          "default": [],
          "items": {
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
            "type": "string"
          },
          "title": "Source Record Ids",
          "type": "array"
        },
        "study_version": {
          "minLength": 1,
          "title": "Study Version",
          "type": "string"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Record Id"
        }
      },
      "required": [
        "study_version",
        "created_at",
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "in_progress",
        "completed",
        "partial",
        "failed",
        "invalid",
        "superseded",
        "accepted"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmarks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Benchmarks",
      "type": "array"
    },
    "configuration_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Configuration Hashes",
      "type": "object"
    },
    "configuration_versions": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Configuration Versions",
      "type": "object"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "environment_id": {
      "minLength": 1,
      "title": "Environment Id",
      "type": "string"
    },
    "failure_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Summary"
    },
    "git_commit": {
      "minLength": 1,
      "title": "Git Commit",
      "type": "string"
    },
    "manifest_revision": {
      "exclusiveMinimum": 0,
      "title": "Manifest Revision",
      "type": "integer"
    },
    "models": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Models",
      "type": "array"
    },
    "output_location": {
      "minLength": 1,
      "title": "Output Location",
      "type": "string"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Run Id"
    },
    "previous_manifest_record_id": {
      "anyOf": [
        {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Manifest Record Id"
    },
    "prompt_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Prompt Hashes",
      "type": "object"
    },
    "prompt_versions": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Prompt Versions",
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "record_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_type": {
      "const": "run_manifest",
      "default": "run_manifest",
      "title": "Record Type",
      "type": "string"
    },
    "run_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "schema_version_used": {
      "minLength": 1,
      "title": "Schema Version Used",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "superseded_by_run_id": {
      "anyOf": [
        {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By Run Id"
    },
    "supersedes_run_id": {
      "anyOf": [
        {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{16,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Run Id"
    },
    "task_scope": {
      "minLength": 1,
      "title": "Task Scope",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "provenance",
    "run_id",
    "manifest_revision",
    "status",
    "started_at",
    "git_commit",
    "environment_id",
    "schema_version_used",
    "configuration_versions",
    "configuration_hashes",
    "prompt_versions",
    "prompt_hashes",
    "models",
    "benchmarks",
    "task_scope",
    "output_location"
  ],
  "title": "RunManifest",
  "type": "object"
}

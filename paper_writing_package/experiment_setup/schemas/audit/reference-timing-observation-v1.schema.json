{
  "$defs": {
    "EvaluationStatus": {
      "enum": [
        "completed",
        "evaluation_failure",
        "timeout",
        "excluded_task"
      ],
      "title": "EvaluationStatus",
      "type": "string"
    },
    "FunctionalOutcome": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "FunctionalOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One isolated reference evaluation, including evaluator-only timing data.",
  "properties": {
    "audit_id": {
      "minLength": 1,
      "title": "Audit Id",
      "type": "string"
    },
    "base_reference_times_seconds": {
      "anyOf": [
        {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Reference Times Seconds"
    },
    "benchmark_id": {
      "enum": [
        "humaneval_plus",
        "mbpp_plus",
        "bigcodebench_instruct"
      ],
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_manifest_version": {
      "minLength": 1,
      "title": "Benchmark Manifest Version",
      "type": "string"
    },
    "benchmark_revision": {
      "minLength": 1,
      "title": "Benchmark Revision",
      "type": "string"
    },
    "dataset_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Sha256",
      "type": "string"
    },
    "declared_libraries": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Declared Libraries",
      "type": "array"
    },
    "elapsed_seconds": {
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "environment_id": {
      "minLength": 1,
      "title": "Environment Id",
      "type": "string"
    },
    "evaluator_configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluator Configuration Sha256",
      "type": "string"
    },
    "evaluator_details": {
      "additionalProperties": true,
      "title": "Evaluator Details",
      "type": "object"
    },
    "evaluator_name": {
      "minLength": 1,
      "title": "Evaluator Name",
      "type": "string"
    },
    "evaluator_version": {
      "minLength": 1,
      "title": "Evaluator Version",
      "type": "string"
    },
    "failure_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Message"
    },
    "failure_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Type"
    },
    "functional_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/FunctionalOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "git_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "load_average_1m": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Load Average 1M"
    },
    "observation_id": {
      "pattern": "^reference_timing_[a-f0-9]{16,64}$",
      "title": "Observation Id",
      "type": "string"
    },
    "plus_reference_times_seconds": {
      "anyOf": [
        {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plus Reference Times Seconds"
    },
    "raw_output_path": {
      "minLength": 1,
      "title": "Raw Output Path",
      "type": "string"
    },
    "raw_output_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Output Sha256",
      "type": "string"
    },
    "repetition": {
      "exclusiveMinimum": 0,
      "title": "Repetition",
      "type": "integer"
    },
    "schema_version": {
      "const": "reference-timing-observation-v1",
      "default": "reference-timing-observation-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EvaluationStatus"
    },
    "task_record_id": {
      "minLength": 1,
      "title": "Task Record Id",
      "type": "string"
    },
    "upstream_task_id": {
      "minLength": 1,
      "title": "Upstream Task Id",
      "type": "string"
    },
    "wall_timeout_seconds": {
      "exclusiveMinimum": 0,
      "title": "Wall Timeout Seconds",
      "type": "number"
    }
  },
  "required": [
    "observation_id",
    "audit_id",
    "git_commit",
    "benchmark_id",
    "benchmark_manifest_version",
    "benchmark_revision",
    "dataset_sha256",
    "evaluator_name",
    "evaluator_version",
    "evaluator_configuration_sha256",
    "environment_id",
    "task_record_id",
    "upstream_task_id",
    "repetition",
    "wall_timeout_seconds",
    "started_at",
    "ended_at",
    "elapsed_seconds",
    "status",
    "raw_output_path",
    "raw_output_sha256"
  ],
  "title": "ReferenceTimingObservation",
  "type": "object"
}

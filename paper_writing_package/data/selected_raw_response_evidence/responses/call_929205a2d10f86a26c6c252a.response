def is_prime(n):
    """Check if a number is prime."""
    if n < 2:
        return False
    if n == 2 or n == 3:
        return True
    if n % 2 == 0 or n % 3 == 0:
        return False
    i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0:
            return False
        i += 6
    return True

def newman_prime(n):
    """
    Find the nth Newman-Shanks-Williams (NSW) prime.
    NSW primes are primes of the form S_k where k is an odd prime.
    The sequence S_k follows the recurrence:
    S_0 = 0
    S_1 = 1
    S_k = 6*S_{k-1} - S_{k-2}
    """
    count = 0
    k = 1
    s_prev = 0 # S_0
    s_curr = 1 # S_1
    
    while True:
        # NSW primes are defined as S_k where k is an odd prime and S_k is prime.
        if k > 2 and is_prime(k):
            if is_prime(s_curr):
                count += 1
                if count == n:
                    return s_curr
        
        # Calculate next term in the sequence S_k = 6*S_{k-1} - S_{k-2}
        s_next = 6 * s_curr - s_prev
        s_prev = s_curr
        s_curr = s_next
        k += 1


def dog_age(human_years):
    """
    Calculate a dog's age in dog's years based on human years.
    
    The calculation follows this pattern:
    - First year of a dog's life equals 15 human years
    - Second year of a dog's life equals 9 human years
    - Each subsequent year equals 5 human years
    
    Args:
        human_years (int): Age in human years
        
    Returns:
        int: Age in dog's years
    """
    if human_years <= 0:
        return 0
    elif human_years == 1:
        return 15
    elif human_years == 2:
        return 15 + 9
    else:
        # For years beyond 2: 15 + 9 + 5 * (years - 2)
        return 15 + 9 + 5 * (human_years - 2)


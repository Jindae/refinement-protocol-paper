def max_sum_increasing_subseq(arr, n, i, k):
    # Check if the indices are valid
    if k <= i or k >= n:
        return 0
    
    # dp[i][j] represents the maximum sum of increasing subsequence ending at index j
    # that includes at least one element from prefix 0 to i
    # We'll use a different approach: for each position, we track the maximum sum
    # of increasing subsequence that includes element at index k
    
    # First, we need to find the maximum sum of increasing subsequence that:
    # 1. Includes elements from prefix 0 to i (inclusive)
    # 2. Includes element at index k
    
    # Let's build a DP approach that ensures we include elements from prefix and k
    # dp[j] will store the maximum sum of increasing subsequence ending at j
    # that includes at least one element from prefix 0 to i
    
    # Initialize dp array
    dp = [0] * n
    for j in range(n):
        dp[j] = arr[j]
    
    # Fill dp array using dynamic programming
    for j in range(1, n):
        for prev in range(j):
            if arr[prev] < arr[j] and dp[prev] + arr[j] > dp[j]:
                dp[j] = dp[prev] + arr[j]
    
    # But we need to ensure that the subsequence includes elements from prefix 0 to i
    # and specifically includes element at index k
    

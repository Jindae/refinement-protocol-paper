def max_sum_increasing_subseq(arr, n, i, k):
    if k <= i or k >= n:
        return 0
    
    # dp[i][0] = max sum of increasing subsequence ending at index i without including element k
    # dp[i][1] = max sum of increasing subsequence ending at index i including element k
    dp = [[0, 0] for _ in range(n)]
    
    # Initialize dp array with array values
    for j in range(n):
        dp[j][0] = arr[j]
        dp[j][1] = arr[j]
    
    # Fill dp array using dynamic programming
    for j in range(1, n):
        for prev in range(j):
            if arr[prev] < arr[j]:
                # Update dp[j][0] - subsequence without including element k
                if dp[prev][0] + arr[j] > dp[j][0]:
                    dp[j][0] = dp[prev][0] + arr[j]
                
                # Update dp[j][1] - subsequence including element k
                if dp[prev][1] + arr[j] > dp[j][1]:
                    dp[j][1] = dp[prev][1] + arr[j]
    

def find_sum(numbers):
    """
    Finds the sum of non-repeated elements in a given list.
    Based on the provided test case [1,2,3,1,1,4,5,6] == 21, 
    this function calculates the sum of the unique elements in the list.
    """
    return sum(set(numbers))

if __name__ == "__main__":
    assert find_sum([1, 2, 3, 1, 1, 4, 5, 6]) == 21

def find_sum(numbers):
    """
    Finds the sum of non-repeated elements in a given list.
    An element is considered non-repeated if it appears exactly once in the list.
    """
    # Count occurrences of each element
    counts = {}
    for num in numbers:
        counts[num] = counts.get(num, 0) + 1
    
    # Sum elements that appeared exactly once
    total_sum = sum(num for num, count in counts.items() if count == 1)
    
    return total_sum

# Test case provided in the specification

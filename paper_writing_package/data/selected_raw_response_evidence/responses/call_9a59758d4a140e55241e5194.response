def tri(n):
    """Generate the first n+1 numbers of the Tribonacci sequence."""
    if n < 0:
        return []

    sequence = [0] * (n + 1)
    if n >= 0:
        sequence[0] = 1
    if n >= 1:
        sequence[1] = 3


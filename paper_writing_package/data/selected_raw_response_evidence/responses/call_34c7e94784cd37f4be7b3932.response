import numpy as np
import matplotlib.pyplot as plt
from statsmodels.formula.api import ols

def task_func(mu, sigma, seed=0, num_samples=1000, num_bins=30):
    # Set the random seed for reproducibility
    np.random.seed(seed)
    
    # Generate random samples from a normal distribution
    samples = np.random.normal(mu, sigma, num_samples)
    
    # Create the histogram
    fig, ax = plt.subplots()
    n, bins, patches = ax.hist(samples, num_bins, density=True, label='Histogram')
    
    # Calculate the PDF of the normal distribution
    x = np.linspace(mu - 3*sigma, mu + 3*sigma, 1000)
    pdf = (1/(sigma * np.sqrt(2 * np.pi))) * np.exp(-0.5 * ((x - mu) / sigma)**2)
    ax.plot(x, pdf, 'r-', label='PDF')
    
    # Convert bins to a DataFrame for OLS regression
    bins_df = np.column_stack((bins[:-1], bins[1:]))
    bins_df = np.column_stack((bins_df, n))
    bins_df = np.column_stack((bins_df, np.zeros_like(bins_df[:, 0])))
    bins_df = np.column_stack((bins_df, np.zeros_like(bins_df[:, 0])))
    bins_df = np.column_stack((bins_df, np.zeros_like(bins_df[:, 0])))
